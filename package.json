{
  "name": "tessera",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b && tsc -p tsconfig.api.json && tsc -p tsconfig.e2e.json",
    "verify:access": "tsx --env-file=.env.local --env-file=.env.e2e.local scripts/verify-access.ts",
    "verify:compaction": "tsx --env-file=.env.local --env-file=.env.e2e.local scripts/verify-compaction.ts",
    "verify:teams": "tsx --env-file=.env.local --env-file=.env.e2e.local scripts/verify-teams.ts",
    "verify:telemetry": "tsx --env-file=.env.local --env-file=.env.e2e.local scripts/verify-telemetry.ts",
    "verify:guests": "tsx --env-file=.env.local --env-file=.env.e2e.local scripts/verify-guests.ts",
    "verify:metrics": "tsx --env-file=.env.local --env-file=.env.e2e.local scripts/verify-metrics.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
